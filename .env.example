# API / общий
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# База (локально через docker compose: postgresql://wiki:wiki@localhost:5432/wiki)
DATABASE_URL=postgresql://wiki:wiki@localhost:5434/wiki

# JWT (минимум 16 символов)
JWT_SECRET=change-me-to-a-long-random-secret

# Первый администратор (создаётся только если в БД ещё нет пользователей)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# CORS для фронта на Vite (через запятую)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
